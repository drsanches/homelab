[Unit]
Description=Nextcloud container service

Requires=docker.service
After=docker.service

Requires={{ nfs_mount_unit }}.mount
After={{ nfs_mount_unit }}.mount

[Service]
#TODO: on-failure?
Restart=always

User={{ nextcloud_user }}
Group={{ nextcloud_user }}
WorkingDirectory={{ nextcloud_path }}

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ nextcloud_path }}

ExecStart=/usr/bin/docker compose --env-file .env up
#TODO: Stop instead of down?
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart

[Install]
WantedBy=multi-user.target
