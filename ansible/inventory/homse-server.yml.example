all:
  hosts:
    home_server:
      ansible_host: 192.168.1.3
      ansible_port: 22
      ansible_user: user
      ansible_ssh_private_key_file: ~/.ssh/homelab-home-server

      nginx_cert_name: example
      nginx_cert_path: path/to/the/cert/example.crt
      nginx_cert_key_path: path/to/the/cert/key/example.key
      #TODO: Refactor?
      nginx_ports: 
        - "9435:9435" #Cockpit
        - "9436:9436" #Nextcloud
      #TODO: Refactor?
      nginx_networks:
        - nginx_nextcloud_network

      nginx_cockpit_external_port: 9435

      nfs_mount_server: "192.168.1.2"
      nfs_mount_export: "/tank/home-server-storage"
      nfs_mount_path: "/mnt/storage"
      nfs_mount_unit: "mnt-storage"
      nfs_mount_options: "rw,hard,_netdev" #TODO: What to do if the server is down? Should we use soft instead of hard?

      #TODO: Refactor
      nginx_nextcloud_network: nginx_nextcloud_network
      nginx_nextcloud_external_port: 9436
      nextcloud_data_directory: /mnt/storage/nextcloud
      nextcloud_db_root_password: pswd
      nextcloud_db_password: pswd
      nextcloud_protocol: https
      nextcloud_host: 192.168.1.3
      nextcloud_port: 9436
